{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/(.*\\.(?:css|js|map|html|pdf|docx|png|jpg|jpeg|gif|bmp|svg|ico|webp|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    { "src": "/(.*)", "dest": "/api/index.php?path=$1" }
  ]
}
